# Copy to demo.env (git-ignored) and fill in. Never commit the real file.

# Preferred: a saved SQLcl connection, so no password is stored here.
#   Create it once in SQLcl:  conn -save <name> -savepwd <user>@<host>:<port>/<service>
SQLCL_CONNECTION=
# Otherwise leave SQLCL_CONNECTION empty and set DB_CONNECT. DB_PASSWORD empty = prompt.
DB_CONNECT=<host>:1521/<service>
DB_PASSWORD=
# Expected session user. Scripts stop if the connection logs in as anyone else.
DB_USER=APP_OWNER

APEX_WORKSPACE=APP_DEMO
APEX_SCHEMA=APP_OWNER
# <app id>:<folder under apex/apps>, comma separated. The folder is the app alias in lowercase.
APEX_APPS=100:my-app
