<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repeatable code objects: re-deployed whenever the file's checksum changes.
  Order matters: specs before bodies, dependencies first.
  executes the file through SQLcl, so the trailing "/" of PL/SQL units works as-is.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- ===== app_owner : package specs ===== -->
  <changeSet id="app_owner.customer_api.pks" author="repeatable" runOnChange="true">
    <sqlFile path="../schemas/app_owner/packages/customer_api.pks" relativeToChangelogFile="true"
             endDelimiter="/" splitStatements="true" stripComments="false"/>
  </changeSet>

  <!-- ===== app_owner : views ===== -->

  <!-- ===== app_owner : package bodies ===== -->
  <changeSet id="app_owner.customer_api.pkb" author="repeatable" runOnChange="true">
    <sqlFile path="../schemas/app_owner/packages/customer_api.pkb" relativeToChangelogFile="true"
             endDelimiter="/" splitStatements="true" stripComments="false"/>
  </changeSet>

  <!-- ===== app_owner : triggers ===== -->

</databaseChangeLog>
