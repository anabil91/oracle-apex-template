# Normalize line endings so Windows and Linux devs/CI produce identical diffs
* text=auto eol=lf

*.sql  text eol=lf
*.pks  text eol=lf
*.pkb  text eol=lf
*.pls  text eol=lf
*.yaml text eol=lf
*.apx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.zip  binary
